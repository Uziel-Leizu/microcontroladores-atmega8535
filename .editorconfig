root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4
max_line_length = 120
trim_trailing_whitespace = false

[*.{cproj,atsln,prj}]
end_of_line = crlf
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab